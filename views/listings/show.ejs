<% layout("layouts/boilerplate") %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="show-wrapper mt-4">

  <!-- Title -->
  <h2 class="show-title"><%= listing.title %></h2>
  <p class="show-location">
    <i class="fa-solid fa-location-dot"></i>
    <%= listing.location %>, <%= listing.country %>
  </p>

  <!-- Image -->
  <img
    src="<%= listing.image.url %>"
    class="show-img"
    alt="<%= listing.title %>"
  />

  <!-- Details -->
  <div class="show-details">
    <div class="show-host">
      <span class="host-avatar">
        <%= listing.owner.username.charAt(0).toUpperCase() %>
      </span>
      <div>
        <div class="host-label">Hosted by</div>
        <div class="host-name"><%= listing.owner.username %></div>
      </div>
    </div>

    <div class="show-price">
      <span class="listing-price">&#x20B9;<%= listing.price.toLocaleString("en-IN") %></span>
      <span class="listing-night">/ night</span>
    </div>
  </div>

  <p class="show-description"><%= listing.description %></p>

  <!-- Edit / Delete (sirf owner ko) -->
  <% if (currentUser && listing.owner._id.equals(currentUser._id)) { %>
    <div class="showbtn">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">
        <i class="fa-solid fa-pen me-1"></i>Edit
      </a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button type="submit" class="btn btn-outline-danger">
          <i class="fa-solid fa-trash me-1"></i>Delete
        </button>
      </form>
    </div>
  <% } %>

  <hr />

  <!-- Review form -->
  <% if (currentUser) { %>
    <h4 class="section-title">Leave a review</h4>
    <form
      action="/listings/<%= listing._id %>/reviews"
      method="post"
      novalidate
      class="needs-validation mb-4"
    >
      <div class="mb-3">
        <label class="form-label">Rating</label>
        <fieldset class="starability-slot">
          <input
            type="radio"
            id="no-rate"
            class="input-no-rate"
            name="review[rating]"
            value="1"
            checked
            aria-label="No rating."
          />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>

      <div class="mb-3">
        <label for="comment" class="form-label">Comment</label>
        <textarea
          name="review[comment]"
          id="comment"
          rows="4"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please add a comment</div>
      </div>

      <button class="btn addbtn text-white">Submit</button>
    </form>
    <hr />
  <% } %>

  <!-- All reviews -->
  <% if (listing.reviews.length > 0) { %>
    <h4 class="section-title">All Reviews</h4>
    <div class="row g-3 mb-4">
      <% for (let review of listing.reviews) { %>
        <div class="col-12 col-md-6">
          <div class="card review-card h-100">
            <div class="card-body">
              <h5 class="card-title">@<%= review.author.username %></h5>
              <p
                class="starability-result"
                data-rating="<%= review.rating %>"
              ></p>
              <p class="card-text"><%= review.comment %></p>

              <% if (currentUser && review.author._id.equals(currentUser._id)) { %>
                <form
                  action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                  method="post"
                >
                  <button class="btn btn-sm btn-outline-dark">Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>
    </div>
    <hr />
  <% } %>

  <!-- Map -->
  <h4 class="section-title">Where you will be</h4>
  <div id="map" class="mb-5"></div>
</div>

<script src="/js/map.js"></script>