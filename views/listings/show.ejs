<% layout("layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-3">
    <h3><%= listing.title %></h3>
  </div>

  <div class="card col-6 offset-3 show-card card-listing">
    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="listing_img"
    />

    <div class="card-body">
      <p class="card-text">
        <p>Owned by <%= listing.owner.username %></p>
        <%= listing.description %> <br />
        <b>&#x20B9;<%=listing.price.toLocaleString("en-IN") %></b> <br />
        <%= listing.location %> <br />
        <%=listing.country %>
      </p>
    </div>
  </div>

 <% if(currentUser && listing.owner._id.equals((currentUser._id))){ %>
  <div class="btns offset-3 showbtn">
    <a
      href="/listings/<%= listing._id %>/edit"
      class="btn btn-primary edit-btn col-1"
    >
      Edit
    </a>
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
      <button type="submit" class="btn btn-danger delete-btn">Delete</button>
    </form>
  </div>
   <% } %>


  <div class="col-8 offset-3 mb-3 mt-3">
    <hr />
    <% if(currentUser){ %>
    <h3>Review here</h3>
    <form
      action="/listings/<%= listing._id %>/reviews"
      method="post"
      novalidate
      class="needs-validation"
    >
      <div>
        <label for="rating" class="form-label">Rating</label>
        <input
          type="range"
          min="1"
          max="5"
          id="rating"
          name="review[rating]"
          class="form-range"
        />
      </div>
      <div>
        <label for="comment" class="form-label">Comment</label>
        <textarea
          name="review[comment]"
          id="comment"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">please add comment</div>
      </div>
      <button class="btn btn-light btn-outline-dark mt-3">Submit</button>
    </form>
      <hr />
    <% } %>

    <p><b>All Reviews</b></p>
     <div class="row">
    <% for(review of listing.reviews){%>
      <div class="card col-5 mb-3 ms-3">
        <div class="card-body">
        <h5 class="card-title">@<%= review.author.username %></h5>
        <p class="card-text"><%= review.comment %></p>
        <p class="card-text"><%= review.rating %> stars</p>
        <form  class="mb-3"  action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
        <button class="btn btn-dark">delete</button>
        </form>
      </div>
      </div>
    <%}%>
    </div>
  </div>
</div>
