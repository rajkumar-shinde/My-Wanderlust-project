<% if (success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show wl-flash" role="alert">
    <%= success[0] %>
    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="alert"
      aria-label="Close">
    </button>
  </div>
<% } %>

<% if (error && error.length) { %>
  <div class="alert alert-danger alert-dismissible fade show wl-flash" role="alert">
    <%= error[0] %>
    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="alert"
      aria-label="Close">
    </button>
  </div>
<% } %>

<!-- Auto-hide: 3 second baad alert band ho jayega -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".wl-flash").forEach((el) => {
      setTimeout(() => {
        if (window.bootstrap && bootstrap.Alert) {
          bootstrap.Alert.getOrCreateInstance(el).close();
        } else {
          el.remove();
        }
      }, 3000);
    });
  });
</script>