<% layout("layouts/boilerplate") %>
<div class="row mt-3">
  <h1 class="col-6 offset-3">SignUp On Wanderlust</h1>
  <div class="col-6 offset-3">
    <form action="/signup" method="post" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          required
          minlength="3"
          maxlength="20"
          pattern="[a-zA-Z0-9_]{3,20}"
          title="Username must be 3-20 characters. Only letters, numbers, and underscores (_) are allowed."
          class="form-control"
        />
        <div class="invalid-feedback">
          Username must be 3-20 characters long. Only letters, numbers, and
          underscores (_) are allowed.
        </div>
        <div class="valid-feedback">Username looks good!</div>
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          pattern="[a-zA-Z0-9._%+-]+@gmail\.com"
          title="Please enter a valid Gmail address ending with @gmail.com"
          class="form-control"
        />
        <div class="invalid-feedback">
          Please enter a valid email ending with @gmail.com.
        </div>
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">password</label>
        <input
          type="text"
          id="password"
          name="password"
          required
          class="form-control"
        />
      </div>
      <button class="btn btn-success">SignUp</button>
    </form>
  </div>
</div>
